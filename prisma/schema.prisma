generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String            @id @default(cuid())
  email                  String            @unique
  passwordHash           String
  firstName              String
  lastName               String
  role                   UserRole?         @default(INDIVIDUAL)
  institutionId          String?
  personalOrganizationId String?           @unique
  isActive               Boolean           @default(true)
  emailVerified          Boolean           @default(false)
  lastLoginAt            DateTime?
  /// Onboarding: bizi nereden buldunuz (sabit id, örn. GOOGLE_SEARCH)
  acquisitionSource        String? @db.VarChar(64)
  /// OTHER seçildiğinde veya kısa açıklama
  acquisitionSourceDetail String? @db.VarChar(200)
  targetScore            Int?
  dailyStudyHours        Int?
  /// İlk giriş kurulum sihirbazı tamamlandığında (veya atlandığında) set edilir
  setupWizardCompletedAt DateTime?
  /// JWT invalidation — şifre değişimi / hesap silme sonrası artırılır
  tokenVersion           Int               @default(0)
  emailNotifications     Boolean           @default(true)
  studyReminders         Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
  emailVerificationTokens EmailVerificationToken[]
  emailChangeTokens      EmailChangeToken[]
  examAssignments        ExamAssignment[]
  examAttempts           ExamAttempt[]
  memberships            Membership[]
  passwordResetTokens    PasswordResetToken[]
  pomodoroSessions       PomodoroSession[]
  userProgress           UserProgress[]
  appSessions            AppSession[]
  parentLinksAsParent    ParentStudentLink[] @relation("ParentStudentLinks")
  parentLinksAsStudent   ParentStudentLink[] @relation("StudentChildLinks")
  institution            Institution?      @relation(fields: [institutionId], references: [id])
  personalOrganization   Organization?     @relation("UserPersonalOrganization", fields: [personalOrganizationId], references: [id])

  @@index([email])
  @@index([institutionId])
  @@index([role])
  @@index([isActive])
  @@index([personalOrganizationId])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("email_change_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  resource  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ParentStudentLink {
  id             String        @id @default(cuid())
  parentUserId   String
  studentUserId  String
  organizationId String?
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  parent         User          @relation("ParentStudentLinks", fields: [parentUserId], references: [id], onDelete: Cascade)
  student        User          @relation("StudentChildLinks", fields: [studentUserId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([parentUserId])
  @@index([studentUserId])
  @@index([organizationId])
  @@map("parent_student_links")
}

model Institution {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  users           User[]

  @@index([code])
  @@index([isActive])
  @@map("institutions")
}

model Exam {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  description     String?
  status          ExamStatus       @default(ACTIVE)
  startDate       DateTime?
  endDate         DateTime?
  organizationId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  examAssignments ExamAssignment[]
  examAttempts    ExamAttempt[]
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  sections        Section[]

  @@index([code])
  @@index([status])
  @@index([startDate, endDate])
  @@index([organizationId])
  @@map("exams")
}

model Section {
  id          String    @id @default(cuid())
  examId      String
  name        String
  code        String
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjects    Subject[]

  @@unique([examId, code])
  @@index([examId])
  @@index([order])
  @@map("sections")
}

model Subject {
  id          String    @id @default(cuid())
  sectionId   String
  name        String
  code        String
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  section     Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@unique([sectionId, code])
  @@index([sectionId])
  @@index([order])
  @@map("subjects")
}

model Topic {
  id                 String         @id @default(cuid())
  subjectId          String
  name               String
  code               String
  description        String?
  order              Int            @default(0)
  examQuestionCount  Int?           // Sınavda bu konudan çıkan soru sayısı (soru dağılımı)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  subject            Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userProgress       UserProgress[]

  @@unique([subjectId, code])
  @@index([subjectId])
  @@index([order])
  @@map("topics")
}

model ExamAssignment {
  id         String    @id @default(cuid())
  examId     String
  userId     String?
  assignedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  exam       Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([userId])
  @@index([userId, deletedAt])
  @@map("exam_assignments")
}

model UserProgress {
  id                     String         @id @default(cuid())
  userId                 String
  topicId                String
  status                 ProgressStatus @default(NOT_STARTED)
  completedAt            DateTime?
  notes                  String?
  totalQuestions         Int?
  correctAnswers         Int?
  wrongAnswers           Int?
  /// Aralıklı tekrar: tamamlama sonrası kaç kez “tekrar ettim” işaretlendi (0 = henüz yok)
  spacedRepetitionLevel  Int            @default(0)
  /// Bir sonraki önerilen tekrar tarihi (UTC)
  nextReviewAt           DateTime?
  lastReviewedAt         DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?
  topic          Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
  @@index([status])
  @@index([userId, deletedAt])
  @@index([topicId, deletedAt])
  @@index([userId, nextReviewAt])
  @@map("user_progress")
}

model PomodoroSession {
  id          String    @id @default(cuid())
  userId      String
  duration    Int
  isBreak     Boolean   @default(false)
  completed   Boolean   @default(false)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startedAt])
  @@index([completed])
  @@index([userId, completed, deletedAt])
  @@map("pomodoro_sessions")
}

// Deneme sınavı takibi: kullanıcının her deneme girişi
model ExamAttempt {
  id               String          @id @default(cuid())
  userId           String
  examId           String
  attemptedAt      DateTime        @default(now())  // Deneme tarihi
  completedAt      DateTime?                         // Teslim tarihi
  totalScore       Decimal?        @db.Decimal(6, 2) // Ham puan (örn. 100 üzerinden)
  netScore         Decimal?        @db.Decimal(6, 2)  // Net puan (doğru - yanlış/4)
  rightCount       Int?                              // Doğru sayısı
  wrongCount       Int?                              // Yanlış sayısı
  emptyCount       Int?                              // Boş sayısı
  durationMinutes  Int?                              // Süre (dakika)
  breakdown        Json?                             // Ders bazlı: [{ subjectId, subjectName, right, wrong, empty, net }]
  topicBreakdown   Json?                             // Konu bazlı deneme: [{ topicId, topicName, subjectName, questionCount, right, wrong, empty, successRate }]
  status           ExamAttemptStatus @default(COMPLETED)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam             Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([examId])
  @@index([attemptedAt])
  @@index([userId, deletedAt])
  @@index([userId, examId, deletedAt])
  @@map("exam_attempts")
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  code            String           @unique
  description     String?
  logo            String?
  isActive        Boolean          @default(true)
  isPersonal      Boolean          @default(false)
  subscriptionId  String?
  currentPlanId   String?
  maxUsers        Int              @default(1)
  maxExams        Int              @default(1)
  maxStudents     Int              @default(10)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  exams           Exam[]
  memberships     Membership[]
  roles           Role[]
  subscriptions   Subscription[]
  parentStudentLinks ParentStudentLink[]
  personalUsers   User?            @relation("UserPersonalOrganization")
  currentPlan     Plan?            @relation("OrganizationCurrentPlan", fields: [currentPlanId], references: [id])
  currentSubscription Subscription? @relation("OrganizationCurrentSubscription", fields: [subscriptionId], references: [id])

  @@index([slug])
  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
  @@index([currentPlanId])
  @@map("organizations")
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  isActive       Boolean      @default(true)
  invitedBy      String?
  invitedAt      DateTime?
  joinedAt       DateTime     @default(now())
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, deletedAt])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@index([userId, isActive, deletedAt])
  @@index([organizationId, isActive, deletedAt])
  @@map("memberships")
}

model Role {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  isDefault      Boolean          @default(false)
  organizationId String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  memberships    Membership[]
  permissions    RolePermission[]
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([organizationId])
  @@index([isSystem])
  @@index([isDefault])
  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  category        String
  isSystem        Boolean          @default(true)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  rolePermissions RolePermission[]

  @@index([code])
  @@index([category])
  @@index([isSystem])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  context      Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Plan {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  description   String?
  type          PlanType
  price         Decimal?       @db.Decimal(10, 2)
  currency      String         @default("USD")
  maxUsers      Int            @default(1)
  maxExams      Int            @default(1)
  maxStudents   Int            @default(10)
  maxStorage    Int?
  features      Json?
  trialDays     Int            @default(0)
  isActive      Boolean        @default(true)
  isPublic      Boolean        @default(true)
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  planFeatures  PlanFeature[]
  subscriptions Subscription[]
  organizationsCurrentPlan Organization[] @relation("OrganizationCurrentPlan")

  @@index([code])
  @@index([type])
  @@index([isActive])
  @@index([isPublic])
  @@map("plans")
}

model Feature {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  description  String?
  category     String
  isSystem     Boolean       @default(true)
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  planFeatures PlanFeature[]

  @@index([code])
  @@index([category])
  @@index([isSystem])
  @@map("features")
}

model PlanFeature {
  id        String   @id @default(cuid())
  planId    String
  featureId String
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([planId])
  @@index([featureId])
  @@map("plan_features")
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  startedAt          DateTime           @default(now())
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  expiresAt          DateTime?
  price              Decimal            @db.Decimal(10, 2)
  currency           String             @default("USD")
  billingCycle       String             @default("monthly")
  paymentMethodId    String?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])
  organizationAsCurrent Organization[]  @relation("OrganizationCurrentSubscription")

  @@index([organizationId])
  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([organizationId, status, deletedAt])
  @@map("subscriptions")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("site_settings")
}

/// Tarayıcı oturumu — uygulamada kalma süresi (first-party analytics)
model AppSession {
  id              String   @id @default(cuid())
  clientSessionId String   @unique @db.VarChar(64)
  userId          String?
  durationSeconds Int
  startedAt       DateTime
  endedAt         DateTime
  lastPath        String?  @db.VarChar(256)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([endedAt])
  @@map("app_sessions")
}

enum UserRole {
  ADMIN
  INSTITUTION_ADMIN
  INDIVIDUAL
  VIEWER
}

enum ExamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ExamAttemptStatus {
  DRAFT      // Taslak / yarım bırakıldı
  COMPLETED  // Tamamlandı
  ABANDONED  // İptal
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  REVIEWED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
  SUSPENDED
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}
