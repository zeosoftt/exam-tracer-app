# Copy to `.env.local` (local) or set in the host dashboard (Vercel, etc.).
# Never commit real secrets.

# --- Required (app + auth) ---
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Oturum ve token süreleri (opsiyonel) ---
# NextAuth: beni hatırla kapalı / açık süreleri (7d, 12h, saniye)
# SESSION_EXPIRES_IN=7d
# SESSION_REMEMBER_EXPIRES_IN=30d
# E-posta doğrulama linki (saat, 1–168)
# EMAIL_VERIFICATION_TTL_HOURS=24
# Şifre sıfırlama linki (dakika, 15–1440)
# PASSWORD_RESET_TTL_MINUTES=60

# --- Email (Resend): doğrulama + destek formu ---
# İkisi de dolu değilse destek formu 503 döner; doğrulama maili gönderilmez (link loglanır).
# RESEND_API_KEY=re_xxxxxxxx
# Üretimde doğrulanmış domainden gönderici kullanın.
# EMAIL_FROM=The Goal Lab <noreply@yourdomain.com>
# Destek taleplerinin düşeceği gelen kutusu
# SUPPORT_INBOX_EMAIL=destek@yourdomain.com

# --- Performans / CDN / TLS (opsiyonel) ---
# Statik _next chunk URL’leri için önek (Cloudflare R2 + özel domain, vb.); boş bırakırsanız site kökünden servis edilir
# ASSET_PREFIX=https://cdn.yourdomain.com
# Reverse proxy arkasında HTTP kalıyorsa 308 ile HTTPS’e zorla (Vercel’de genelde gerekmez; x-forwarded-proto kullanılır)
# FORCE_HTTPS_REDIRECT=true

# --- Opsiyonel ---
# Shopier ödeme webhook imzası (HMAC-SHA256, x-shopier-signature header)
# SHOPIER_WEBHOOK_SECRET=
# Upstash Redis — dağıtık rate limit (yoksa bellek içi fallback)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Birden fazla origin virgülle (CORS)
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
# Kanonik site URL (SEO); yoksa NEXTAUTH_URL / VERCEL_URL kullanılır
# SITE_URL=https://yourdomain.com
# Google Search Console HTML doğrulama (isteğe bağlı; kodda varsayılan da var)
# GOOGLE_SITE_VERIFICATION=...
# JSON-LD Organization sameAs — virgülle ayrı resmi sosyal profil URL’leri
# ORGANIZATION_SAME_AS=https://www.instagram.com/yourbrand,https://www.linkedin.com/company/yourbrand

# Winston vb.
# LOG_LEVEL=info

# --- Sentry (opsiyonel APM / hata izleme) ---
# Sunucu + build plugin:
# SENTRY_DSN=https://xxx@xxx.ingest.de.sentry.io/xxx
# İstemci hataları (genelde aynı DSN):
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.de.sentry.io/xxx
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
# Kaynak haritası yükleme (deploy/CI):
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=
# SENTRY_RELEASE=
