# Copy to `.env.local` (local) or set in the host dashboard (Vercel, etc.).
# Never commit real secrets.

# --- Required (app + auth) ---
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Oturum ve token süreleri (opsiyonel) ---
# NextAuth: beni hatırla kapalı / açık süreleri (7d, 12h, saniye)
# SESSION_EXPIRES_IN=7d
# SESSION_REMEMBER_EXPIRES_IN=30d
# E-posta doğrulama linki (saat, 1–168)
# EMAIL_VERIFICATION_TTL_HOURS=24
# Şifre sıfırlama linki (dakika, 15–1440)
# PASSWORD_RESET_TTL_MINUTES=60

# --- Email (Resend): doğrulama + destek formu ---
# İkisi de dolu değilse destek formu 503 döner; doğrulama maili gönderilmez (link loglanır).
# RESEND_API_KEY=re_xxxxxxxx
# Üretimde doğrulanmış domainden gönderici kullanın.
# EMAIL_FROM=The Goal Lab <noreply@yourdomain.com>
# Destek taleplerinin düşeceği gelen kutusu
# SUPPORT_INBOX_EMAIL=destek@yourdomain.com

# --- Opsiyonel ---
# Birden fazla origin virgülle (CORS)
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
# Kanonik site URL (SEO); yoksa NEXTAUTH_URL / VERCEL_URL kullanılır
# SITE_URL=https://yourdomain.com

# Winston vb.
# LOG_LEVEL=info
